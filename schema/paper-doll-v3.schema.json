{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/urcades/paperdoll/main/schema/paper-doll-v3.schema.json",
  "title": "paper-doll/v3 document",
  "description": "A body-like arrangement of vessels. This schema is the structural companion to the current normative paper-doll/v3 specification in docs/spec.md; it captures shape, ids, known keys, and sides. The specification defines every semantic law beyond JSON Schema, including reciprocity, opposition, planarity, reachability, compatibility, recursive validity, identity, addressing, and operation behavior.",
  "type": "object",
  "required": [
    "protocol",
    "body"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "paper-doll/v3"
    },
    "body": {
      "$ref": "#/$defs/body"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "side": {
      "enum": [
        "top",
        "right",
        "bottom",
        "left"
      ]
    },
    "portAddress": {
      "type": "object",
      "required": [
        "vessel",
        "side"
      ],
      "additionalProperties": false,
      "properties": {
        "vessel": {
          "$ref": "#/$defs/id"
        },
        "side": {
          "$ref": "#/$defs/side"
        }
      }
    },
    "acceptToken": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "containedElement": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "$ref": "#/$defs/id"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "data": true,
        "body": {
          "$ref": "#/$defs/body"
        }
      }
    },
    "vessel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accepts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/acceptToken"
          }
        },
        "contains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/containedElement"
          }
        },
        "ports": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top": {
              "$ref": "#/$defs/portAddress"
            },
            "right": {
              "$ref": "#/$defs/portAddress"
            },
            "bottom": {
              "$ref": "#/$defs/portAddress"
            },
            "left": {
              "$ref": "#/$defs/portAddress"
            }
          }
        }
      }
    },
    "body": {
      "type": "object",
      "required": [
        "root",
        "vessels"
      ],
      "additionalProperties": false,
      "properties": {
        "root": {
          "$ref": "#/$defs/id"
        },
        "vessels": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/vessel"
          }
        }
      }
    }
  }
}
